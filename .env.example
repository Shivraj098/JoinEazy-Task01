# --- Application ---
NODE_ENV=development
PORT=4000

# --- Database ---
# Local Docker Postgres (see docker-compose.yml). The container is published on host port 5433.
DATABASE_URL=postgresql://joineazy:joineazy@localhost:5433/joineazy

# Direct (non-pooled) connection, used only by the Prisma CLI for migrations.
# Leave unset locally. With Neon, set it to the direct connection string and
# keep DATABASE_URL pointing at the pooled one.
# DIRECT_URL=

# --- Docker Compose database credentials (optional overrides) ---
POSTGRES_USER=joineazy
POSTGRES_PASSWORD=joineazy
POSTGRES_DB=joineazy
