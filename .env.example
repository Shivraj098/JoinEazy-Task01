# --- Application ---
NODE_ENV=development
PORT=4000

# --- Authentication ---
# Generate a secret with:
#   node -p "require('node:crypto').randomBytes(48).toString('base64url')"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN_HOURS=24
AUTH_COOKIE_NAME=joineazy_session
# Origin of the dev frontend, accepted by the CSRF origin check. In production
# the request's own host is accepted automatically.
APP_ORIGIN=http://localhost:5173

# --- Admin account (created by `npm run db:seed`) ---
ADMIN_NAME=Professor Demo
ADMIN_EMAIL=admin@joineazy.local
ADMIN_PASSWORD=change-this-admin-password

# --- Database ---
# Local Docker Postgres (see docker-compose.yml). The container is published on host port 5433.
DATABASE_URL=postgresql://joineazy:joineazy@localhost:5433/joineazy

# Direct (non-pooled) connection, used only by the Prisma CLI for migrations.
# Leave unset locally. With Neon, set it to the direct connection string and
# keep DATABASE_URL pointing at the pooled one.
# DIRECT_URL=

# --- Docker Compose database credentials (optional overrides) ---
POSTGRES_USER=joineazy
POSTGRES_PASSWORD=joineazy
POSTGRES_DB=joineazy
